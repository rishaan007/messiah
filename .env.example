# ==============================================================================
# MESSIAH ENVIRONMENT CONFIGURATION
# Product: MESSIAH — The Universal AI Agent Workspace
# Tagline: One intelligence layer. Every agent. Every device.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE ENVIRONMENT & LOGGING
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. FASTIFY BACKEND SERVER
# ------------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE (PRISMA ORM)
# ------------------------------------------------------------------------------
POSTGRES_USER=messiah_admin
POSTGRES_PASSWORD=messiah_dev_secure_password_replace_in_prod
POSTGRES_DB=messiah_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ------------------------------------------------------------------------------
# 4. REDIS (EPHEMERAL REALTIME & QUEUES)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=messiah_redis_dev_password
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# ------------------------------------------------------------------------------
# 5. FRONTEND (NEXT.JS 16 WEB APP)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 6. SUPABASE AUTH & IDENTITY PROVIDER (PHASE 1B)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-backend-verification-minimum-32-chars
# Optional JWKS URL for asymmetric ES256/RS256 JWT verification:
# SUPABASE_JWKS_URL=https://your-project.supabase.co/rest/v1/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 7. AI PROVIDER CREDENTIAL VAULT (PHASE 2A)
# ------------------------------------------------------------------------------
# 256-bit (32-byte) AES-256-GCM master key (64 hex characters or >= 32 chars)
VAULT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


