    "@tauri-apps/api": "^2.10.0"
  },
  "devDependencies": {
    "@messiah/config": "workspace:*",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.0.0",
    "eslint": "^9.21.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
