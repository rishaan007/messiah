{
  "name": "@messiah/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MESSIAH Tauri 2 Desktop Application (macOS, Windows, Linux)",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
