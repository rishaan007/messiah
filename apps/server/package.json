{
  "name": "@messiah/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/websocket": "^11.3.7",
    "@messiah/agents": "workspace:*",
    "@messiah/db": "workspace:*",
    "@messiah/mcp": "workspace:*",
    "@messiah/memory": "workspace:*",
    "@messiah/providers": "workspace:*",
    "@messiah/shared": "workspace:*",
    "@messiah/workflows": "workspace:*",
    "bullmq": "^6.7.8",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.5.0",
    "jose": "^6.2.18",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@messiah/bridge-daemon": "workspace:*",
    "@messiah/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.21.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "ws": "^8.18.0"
  }
}
