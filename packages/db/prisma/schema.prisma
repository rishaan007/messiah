model BridgeTask {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  deviceId        String               @map("device_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  threadId        String?              @map("thread_id") @db.Uuid
  generationRunId String?              @map("generation_run_id") @db.Uuid
  agentRunId      String?              @map("agent_run_id") @db.Uuid
  agentTaskId     String?              @map("agent_task_id") @db.Uuid
  capability      String               @db.VarChar(64)
  resourceScopes  String[]             @default([]) @map("resource_scopes")
  parameters      Json                 @default("{}") @db.JsonB
  argumentsHash   String               @map("arguments_hash") @db.VarChar(64)
  status          BridgeTaskStatus     @default(QUEUED)
  result          Json?                @db.JsonB
  errorMessage    String?              @map("error_message") @db.Text
  exitCode        Int?                 @map("exit_code")
  durationMs      Int?                 @map("duration_ms")
  issuedAt        DateTime             @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(6)
  startedAt       DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
