}

model BridgeTaskApproval {
  id                String             @id @default(uuid()) @db.Uuid
  taskId            String             @unique @map("task_id") @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  deviceId          String             @map("device_id") @db.Uuid
  requestedByUserId String?            @map("requested_by_user_id") @db.Uuid
  decidedByUserId   String?            @map("decided_by_user_id") @db.Uuid
  status            ToolApprovalStatus @default(PENDING)
  operation         String             @db.VarChar(128)
  summary           String             @db.Text
  details           Json               @default("{}") @db.JsonB
  argumentsHash     String             @map("arguments_hash") @db.VarChar(64)
  capability        String?            @db.VarChar(64)
  resourceScopes    String[]           @default([]) @map("resource_scopes")
  executableIdentity String?           @map("executable_identity") @db.Text
  mcpServerName     String?            @map("mcp_server_name") @db.VarChar(128)
  mcpSchemaHash     String?            @map("mcp_schema_hash") @db.VarChar(64)
  nonce             String             @db.VarChar(64)
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(6)
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(6)
