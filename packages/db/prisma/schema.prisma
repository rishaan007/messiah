  targetBridgeDevice   BridgeDevice?              @relation(fields: [targetBridgeDeviceId], references: [id], onDelete: SetNull)
  executions           AgentExecution[]
  communications       AgentCommunication[]
  artifacts            AgentArtifact[]
  toolCalls            ToolCall[]
  bridgeTasks          BridgeTask[]

  @@unique([runId, taskKey])
  @@index([runId, status])
  @@index([runId, fingerprint])
  @@index([workspaceId, assignedAgentId])
  @@map("agent_tasks")
}

model AgentExecution {
  id                   String                     @id @default(uuid()) @db.Uuid
  runId                String                     @map("run_id") @db.Uuid
  taskId               String?                    @map("task_id") @db.Uuid
  workspaceId          String                     @map("workspace_id") @db.Uuid
  agentId              String                     @map("agent_id") @db.Uuid
  versionId            String?                    @map("version_id") @db.Uuid
  phase                String                     @db.VarChar(32)
  status               AgentExecutionStatus       @default(RUNNING)
  providerConnectionId String?                    @map("provider_connection_id") @db.Uuid
  modelId              String?                    @map("model_id") @db.VarChar(128)
  iterationsUsed       Int                        @default(0) @map("iterations_used")
  toolCallIds          String[]                   @default([]) @map("tool_call_ids")
  bridgeTaskIds        String[]                   @default([]) @map("bridge_task_ids")
  inputTokens          Int                        @default(0) @map("input_tokens")
  outputTokens         Int                        @default(0) @map("output_tokens")
  durationMs           Int?                       @map("duration_ms")
  resultSummary        String?                    @map("result_summary") @db.Text
  errorMessage         String?                    @map("error_message") @db.Text
  startedAt            DateTime                   @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?                  @map("completed_at") @db.Timestamptz(6)

  // Relations
  run                  AgentRun                   @relation(fields: [runId], references: [id], onDelete: Cascade)
  task                 AgentTask?                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace            Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent                AgentDefinition            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  version              AgentConfigurationVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([runId, startedAt])
  @@index([taskId])
  @@index([workspaceId, agentId])
  @@map("agent_executions")
}

model AgentCommunication {
  id            String     @id @default(uuid()) @db.Uuid
  runId         String     @map("run_id") @db.Uuid
  taskId        String?    @map("task_id") @db.Uuid
  workspaceId   String     @map("workspace_id") @db.Uuid
  fromAgentId   String?    @map("from_agent_id") @db.Uuid
  toAgentId     String?    @map("to_agent_id") @db.Uuid
  messageType   String     @map("message_type") @db.VarChar(32)
  summary       String     @db.Text
  payloadDigest String     @map("payload_digest") @db.VarChar(64)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  run           AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  task          AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([workspaceId])
  @@map("agent_communications")
}

model AgentArtifact {
  id           String     @id @default(uuid()) @db.Uuid
  runId        String     @map("run_id") @db.Uuid
  taskId       String?    @map("task_id") @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  agentId      String?    @map("agent_id") @db.Uuid
  artifactType String     @map("artifact_type") @db.VarChar(48)
  title        String     @db.VarChar(160)
  content      String     @db.Text
  metadata     Json       @default("{}") @db.JsonB
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  run          AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  task         AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([workspaceId])
  @@map("agent_artifacts")
}

model AgentRunEvent {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  sequence    Int
  eventType   String    @map("event_type") @db.VarChar(64)
  taskId      String?   @map("task_id") @db.Uuid
  agentId     String?   @map("agent_id") @db.Uuid
  payload     Json      @default("{}") @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([workspaceId])
  @@map("agent_run_events")
}
