  ACTIVE
  ARCHIVED
}

enum AgentRunStatus {
  PENDING
  PLANNING
  AWAITING_PLAN_APPROVAL
  RUNNING
  AWAITING_APPROVAL
  SYNTHESIZING
  COMPLETED
  PARTIAL_COMPLETED
  FAILED
  CANCELLED
}

enum AgentTaskStatus {
