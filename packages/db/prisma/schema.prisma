  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
  UNKNOWN_OUTCOME
}

enum AgentExecutionStatus {
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
  UNKNOWN_OUTCOME
}

model AgentDefinition {
  id                        String                     @id @default(uuid()) @db.Uuid
  workspaceId               String                     @map("workspace_id") @db.Uuid
  createdByUserId           String?                    @map("created_by_user_id") @db.Uuid
  name                      String                     @db.VarChar(128)
  slug                      String                     @db.VarChar(128)
  roleTitle                 String                     @map("role_title") @db.VarChar(128)
  category                  String                     @default("custom") @db.VarChar(64)
  description               String?                    @db.Text
  avatarAccent              String?                    @map("avatar_accent") @db.VarChar(32)
  isTemplate                Boolean                    @default(false) @map("is_template")
  canSupervise              Boolean                    @default(false) @map("can_supervise")
  status                    AgentStatus                @default(ACTIVE)
  activeVersion             Int                        @default(1) @map("active_version")
  providerConnectionId      String?                    @map("provider_connection_id") @db.Uuid
  modelId                   String?                    @map("model_id") @db.VarChar(128)
  systemPrompt              String                     @map("system_prompt") @db.Text
  temperature               Float                      @default(0.3)
  maxOutputTokens           Int                        @default(4096) @map("max_output_tokens")
  allowedMcpToolIds         String[]                   @default([]) @map("allowed_mcp_tool_ids")
  allowedBridgeCapabilities String[]                   @default([]) @map("allowed_bridge_capabilities")
  preferredBridgeDeviceId   String?                    @map("preferred_bridge_device_id") @db.Uuid
  defaultExecutionBudget    Json                       @default("{}") @map("default_execution_budget") @db.JsonB
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  workspace                 Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser             User?                      @relation("CreatedAgentDefinitions", fields: [createdByUserId], references: [id], onDelete: SetNull)
  providerConnection        ProviderConnection?        @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  preferredBridgeDevice     BridgeDevice?              @relation(fields: [preferredBridgeDeviceId], references: [id], onDelete: SetNull)
  versions                  AgentConfigurationVersion[]
  supervisedRuns            AgentRun[]                 @relation("SupervisorAgent")
  assignedTasks             AgentTask[]                @relation("AssignedAgent")
  executions                AgentExecution[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, canSupervise])
  @@map("agent_definitions")
}

model AgentConfigurationVersion {
  id                        String              @id @default(uuid()) @db.Uuid
  agentDefinitionId         String              @map("agent_definition_id") @db.Uuid
  workspaceId               String              @map("workspace_id") @db.Uuid
  versionNumber             Int                 @map("version_number")
  name                      String              @db.VarChar(128)
  roleTitle                 String              @map("role_title") @db.VarChar(128)
  canSupervise              Boolean             @default(false) @map("can_supervise")
  providerConnectionId      String?             @map("provider_connection_id") @db.Uuid
  modelId                   String?             @map("model_id") @db.VarChar(128)
  systemPrompt              String              @map("system_prompt") @db.Text
  temperature               Float               @default(0.3)
  maxOutputTokens           Int                 @default(4096) @map("max_output_tokens")
  allowedMcpToolIds         String[]            @default([]) @map("allowed_mcp_tool_ids")
  allowedBridgeCapabilities String[]            @default([]) @map("allowed_bridge_capabilities")
  preferredBridgeDeviceId   String?             @map("preferred_bridge_device_id") @db.Uuid
  executionBudget           Json                @default("{}") @map("execution_budget") @db.JsonB
  configHash                String              @map("config_hash") @db.VarChar(64)
  createdByUserId           String?             @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  agentDefinition           AgentDefinition     @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  workspace                 Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerConnection        ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  createdByUser             User?               @relation("CreatedAgentVersions", fields: [createdByUserId], references: [id], onDelete: SetNull)
  supervisorRuns            AgentRun[]          @relation("SupervisorVersion")
  assignedTasks             AgentTask[]         @relation("AssignedTaskVersion")
  executions                AgentExecution[]

  @@unique([agentDefinitionId, versionNumber])
  @@index([workspaceId, agentDefinitionId])
  @@map("agent_configuration_versions")
}

model AgentRun {
  id                      String                     @id @default(uuid()) @db.Uuid
  workspaceId             String                     @map("workspace_id") @db.Uuid
  createdByUserId         String?                    @map("created_by_user_id") @db.Uuid
  threadId                String?                    @map("thread_id") @db.Uuid
  assistantMessageId      String?                    @map("assistant_message_id") @db.Uuid
  supervisorAgentId       String                     @map("supervisor_agent_id") @db.Uuid
  supervisorVersionId     String?                    @map("supervisor_version_id") @db.Uuid
  workerAgentIds          String[]                   @default([]) @map("worker_agent_ids")
  objective               String                     @db.Text
  status                  AgentRunStatus             @default(PENDING)
  requirePlanApproval     Boolean                    @default(false) @map("require_plan_approval")
  planApprovedAt          DateTime?                  @map("plan_approved_at") @db.Timestamptz(6)
  planJson                Json?                      @map("plan_json") @db.JsonB
  maxTotalTokens          Int                        @default(120000) @map("max_total_tokens")
  maxCostUsd              Float                      @default(2.0) @map("max_cost_usd")
