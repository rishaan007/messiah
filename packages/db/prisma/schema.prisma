  claimedDevice        BridgeDevice?          @relation(fields: [claimedDeviceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([expiresAt])
  @@map("device_pairing_challenges")
}

model DeviceConnectionSession {
  id                   String                 @id @default(uuid()) @db.Uuid
  deviceId             String                 @map("device_id") @db.Uuid
  ipAddress            String?                @map("ip_address") @db.VarChar(64)
  userAgent            String?                @map("user_agent") @db.VarChar(255)
  connectedAt          DateTime               @default(now()) @map("connected_at") @db.Timestamptz(6)
  lastHeartbeatAt      DateTime               @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  disconnectedAt       DateTime?              @map("disconnected_at") @db.Timestamptz(6)
  disconnectReason     String?                @map("disconnect_reason") @db.VarChar(64)
  expiresAt            DateTime               @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  device               BridgeDevice           @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, disconnectedAt])
  @@index([expiresAt])
  @@map("device_connection_sessions")
}

