  replanCount             Int                        @default(0) @map("replan_count")
  inputTokens             Int                        @default(0) @map("input_tokens")
  outputTokens            Int                        @default(0) @map("output_tokens")
  estimatedCostUsd        Float                      @default(0) @map("estimated_cost_usd")
  finalSummary            String?                    @map("final_summary") @db.Text
  safeErrorCode           String?                    @map("safe_error_code") @db.VarChar(64)
  errorMessage            String?                    @map("error_message") @db.Text
  cancellationRequestedAt DateTime?                  @map("cancellation_requested_at") @db.Timestamptz(6)
  startedAt               DateTime?                  @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime?                  @map("completed_at") @db.Timestamptz(6)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  workspace               Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser           User?                      @relation("CreatedAgentRuns", fields: [createdByUserId], references: [id], onDelete: SetNull)
  thread                  Thread?                    @relation(fields: [threadId], references: [id], onDelete: SetNull)
  supervisorAgent         AgentDefinition            @relation("SupervisorAgent", fields: [supervisorAgentId], references: [id], onDelete: Restrict)
  supervisorVersion       AgentConfigurationVersion? @relation("SupervisorVersion", fields: [supervisorVersionId], references: [id], onDelete: SetNull)
  tasks                   AgentTask[]
  executions              AgentExecution[]
  communications          AgentCommunication[]
  artifacts               AgentArtifact[]
  events                  AgentRunEvent[]
  toolCalls               ToolCall[]
  bridgeTasks             BridgeTask[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([threadId])
  @@map("agent_runs")
}

model AgentTask {
  id                   String                     @id @default(uuid()) @db.Uuid
  runId                String                     @map("run_id") @db.Uuid
  workspaceId          String                     @map("workspace_id") @db.Uuid
