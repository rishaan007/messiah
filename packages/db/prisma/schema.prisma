  stream    String     @db.VarChar(16) // "stdout" | "stderr" | "system"
  chunk     String     @db.Text
  timestamp DateTime   @default(now()) @db.Timestamptz(6)

  // Relations
  task      BridgeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sequence])
  @@map("bridge_task_logs")
}

