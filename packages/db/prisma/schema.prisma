  task              BridgeTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  device            BridgeDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedByUser   User?              @relation("RequestedBridgeApprovals", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decidedByUser     User?              @relation("DecidedBridgeApprovals", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([deviceId, status])
  @@index([expiresAt])
  @@map("bridge_task_approvals")
}

model BridgeTaskLog {
  id        String     @id @default(uuid()) @db.Uuid
  taskId    String     @map("task_id") @db.Uuid
