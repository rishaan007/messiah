# ==============================================================================
# MESSIAH PRODUCTION ENVIRONMENT TEMPLATE
# All security secrets are MANDATORY in NODE_ENV=production (server fails closed).
# ==============================================================================
NODE_ENV=production
LOG_LEVEL=info
PORT=3001
HOST=0.0.0.0

# Explicit HTTPS origins (wildcards '*' are strictly rejected in production)
CORS_ORIGIN=https://app.messiah.example.com
MESSIAH_ALLOWED_ORIGINS=https://app.messiah.example.com

# Managed PostgreSQL 16 + pgvector (use SSL + connection pooling limits)
POSTGRES_USER=messiah_prod
POSTGRES_PASSWORD=REPLACE_UNIQUE_PRODUCTION_POSTGRES_PASSWORD
POSTGRES_DB=messiah_prod
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&connection_limit=30&sslmode=require"

# Managed Redis 7.2+ with password & AOF enabled
REDIS_PASSWORD=REPLACE_UNIQUE_PRODUCTION_REDIS_PASSWORD
REDIS_URL="rediss://:${REDIS_PASSWORD}@redis:6379"

# Web & Realtime URLs (TLS HTTPS + WSS required)
NEXT_PUBLIC_API_URL=https://app.messiah.example.com
NEXT_PUBLIC_WS_URL=wss://app.messiah.example.com/api/v1/realtime

# Supabase Identity
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_PRODUCTION_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_JWT_SECRET=REPLACE_PRODUCTION_SUPABASE_JWT_SECRET_MIN_32_CHARS

# AES-256-GCM Master Key Encryption Key (generate via `openssl rand -hex 32`)
VAULT_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_KEY

# Web Push VAPID Credentials (`npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@messiah.example.com

# Optional Private Object Storage (never configure public bucket ACLs)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_SIGNED_URL_TTL_SECONDS=300

# Observability & Rate Limiting
MESSIAH_METRICS_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_24_METRICS_TOKEN
RATE_LIMIT_MAX_PER_MIN=180
WORKER_CONCURRENCY=10
