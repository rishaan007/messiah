# ==============================================================================
# MESSIAH STAGING ENVIRONMENT TEMPLATE
# Copy to .env.staging and supply unique staging credentials (NEVER commit real secrets)
# ==============================================================================
NODE_ENV=production
LOG_LEVEL=info
PORT=3001
HOST=0.0.0.0

CORS_ORIGIN=https://staging.messiah.example.com
MESSIAH_ALLOWED_ORIGINS=https://staging.messiah.example.com

POSTGRES_USER=messiah_staging
POSTGRES_PASSWORD=REPLACE_STRONG_STAGING_DB_PASSWORD
POSTGRES_DB=messiah_staging
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&connection_limit=20"

REDIS_PASSWORD=REPLACE_STRONG_STAGING_REDIS_PASSWORD
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"

NEXT_PUBLIC_API_URL=https://staging.messiah.example.com
NEXT_PUBLIC_WS_URL=wss://staging.messiah.example.com/api/v1/realtime
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_SUPABASE_PUBLISHABLE_KEY

SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_JWT_SECRET=REPLACE_SUPABASE_JWT_SECRET_MIN_32_CHARS
VAULT_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_64_HEX_AES256_MASTER_KEY

# Optional Web Push VAPID pair (`npx web-push generate-vapid-keys`)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@messiah.example.com

# Prometheus metrics Bearer token
MESSIAH_METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_BEARER_TOKEN
WORKER_CONCURRENCY=5
